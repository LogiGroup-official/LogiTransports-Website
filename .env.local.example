# Copy this file to .env.local for local development and set your own password.
# Without this, the admin panel falls back to "logitransports".
ADMIN_PASSWORD=change-me

# --- Upstash Redis (production storage for the admin panel) ---
# Don't set these manually: in the Vercel dashboard, go to your project ->
# Storage -> Browse Storage -> "Upstash" (under Marketplace Database
# Providers) -> create/connect a Redis database. Vercel injects the right
# env vars automatically on every deployment. Locally, if these aren't set,
# the app just reads/writes data/network-data.json on disk instead — no
# database needed for dev.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
